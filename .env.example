# ─── Supabase — Data project (waitlist, pathologist_consultations) ────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── Supabase — Auth project (users / authentication) ────────────────────────
VITE_SUPABASE_AUTH_URL=https://<auth-project-ref>.supabase.co
VITE_SUPABASE_AUTH_ANON_KEY=eyJ...

# ─── SMTP (Supabase Edge Functions → notify-pathologist-consultation) ─────────
# Configure também em: Supabase Dashboard → Settings → Edge Functions → Secrets
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@laboratoriolab.com.br
SMTP_PASS=<gmail-app-password>
SMTP_FROM=Laboratorio LAB <no-reply@laboratoriolab.com.br>
NOTIFY_TO=qualidade@laboratoriolab.com.br
NOTIFY_WEBHOOK_SECRET=<string-aleatoria-segura>

# Secret compartilhado entre o trigger SQL e a Edge Function
# Gere com: openssl rand -hex 32
NOTIFY_WEBHOOK_SECRET=<string-aleatoria-segura>
